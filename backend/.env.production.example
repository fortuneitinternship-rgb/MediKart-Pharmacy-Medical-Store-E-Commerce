APP_ENV=production

MYSQL_DATABASE=medikart
MYSQL_USER=medikart_user
MYSQL_PASSWORD=replace_with_a_long_random_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_long_random_password
DATABASE_URL=mysql+pymysql://medikart_user:URL_ENCODED_PASSWORD@db:3306/medikart

SECRET_KEY=replace_with_a_random_secret_at_least_32_characters
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
PAYMENT_MODE=razorpay
RAZORPAY_KEY_ID=rzp_live_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_live_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_the_webhook_secret_configured_in_razorpay
GST_RATE_PERCENT=0
FREE_DELIVERY_THRESHOLD=499
STANDARD_DELIVERY_CHARGE=10
EXPRESS_DELIVERY_MINIMUM=299
EXPRESS_DELIVERY_CHARGE=49
SAME_DAY_DELIVERY_MINIMUM=999
SAME_DAY_DELIVERY_CHARGE=99
FRONTEND_ORIGINS=https://shop.example.com
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60
