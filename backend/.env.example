# Copy to backend/.env. SQLite works without installing a separate database server.
# All API-created records persist in backend/medikart.db with this setting.
DATABASE_URL=sqlite:///./medikart.db

# Generate a private key before deployment (example command in README).
SECRET_KEY=replace_with_a_long_random_secret_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Optional: required only for email OTP delivery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60

# For MySQL instead, replace DATABASE_URL with:
# DATABASE_URL=mysql+pymysql://medikart_user:URL_ENCODED_PASSWORD@127.0.0.1:3306/medikart
# Create the medikart database and user in MySQL before starting the backend.
