# Copy this file to .env in the backend folder and edit values.
# MySQL option:
DATABASE_URL=mysql+pymysql://medikart_user:CHANGE_ME@localhost:3306/medikart
# For a quick local smoke test only, SQLite is also supported:
# DATABASE_URL=sqlite:///./medikart.db

SECRET_KEY=replace_with_a_long_random_secret_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60
