# ---------- MediKart backend (local development) ----------
# MySQL: user=root  password=root  database=medikart
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/medikart

APP_ENV=development
SECRET_KEY=medikart-local-dev-secret-key-please-change-1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

PAYMENT_MODE=simulator
PAYMENT_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

GST_RATE_PERCENT=0
FREE_DELIVERY_THRESHOLD=499
STANDARD_DELIVERY_CHARGE=10
EXPRESS_DELIVERY_MINIMUM=299
EXPRESS_DELIVERY_CHARGE=49
SAME_DAY_DELIVERY_MINIMUM=999
SAME_DAY_DELIVERY_CHARGE=99

# Optional - only needed for the email OTP (forgot password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60

# ---------- Only used by docker-compose.yml ----------
MYSQL_DATABASE=medikart
MYSQL_USER=medikart_user
MYSQL_PASSWORD=root
MYSQL_ROOT_PASSWORD=root
