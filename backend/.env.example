# Copy this file to backend/.env and set your local MySQL credentials.
# For SQLite local development, replace DATABASE_URL with:
# DATABASE_URL=sqlite:///./medikart.db
# Local Docker Compose database credentials; replace before any shared deployment.
MYSQL_DATABASE=medikart
MYSQL_USER=medikart_user
MYSQL_PASSWORD=local-only-change-me
MYSQL_ROOT_PASSWORD=local-only-change-me
DATABASE_URL=mysql+pymysql://medikart_user:root@localhost:3306/medikart

SECRET_KEY=replace_with_a_long_random_secret_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173

# Optional: required only for email OTP delivery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60
